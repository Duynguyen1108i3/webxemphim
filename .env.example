NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080
# Keep lax for same-origin /api proxy deployments. Use none only for separate HTTPS frontend/API domains.
AUTH_COOKIE_SAME_SITE=lax
DATABASE_URL=postgresql://streamforge:streamforge@localhost:5432/streamforge?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-64-char-access-secret
JWT_REFRESH_SECRET=replace-with-64-char-refresh-secret
COOKIE_SECRET=replace-with-cookie-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=streamforge-media
AWS_ACCESS_KEY_ID=replace
AWS_SECRET_ACCESS_KEY=replace
STRIPE_SECRET_KEY=replace
STRIPE_WEBHOOK_SECRET=replace
GMAIL_WEBHOOK_URL=https://script.google.com/macros/s/replace/exec
GMAIL_WEBHOOK_SECRET=replace-with-a-long-random-secret
